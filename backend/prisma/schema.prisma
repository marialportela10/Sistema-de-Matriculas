generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

// Aluno pode se matricular em varias turmas.
model Aluno {
  id              Int           @id @default(autoincrement())
  nome            String
  email           String        @unique
  numeroMatricula String        @unique
  senhaHash       String?
  cursoId         Int
  curso           Curso          @relation(fields: [cursoId], references: [id])
  sessoes         Sessao[]
  matriculas      Matricula[]
  listaEspera     ListaEspera[]
  historico       Historico[]
}

// Uma disciplina pode oferecer varias turmas.
model Disciplina {
  id           Int     @id @default(autoincrement())
  codigo       String  @unique
  nome         String
  cargaHoraria Int
  ementa       String?
  turmas       Turma[]
  curriculos   CurriculoDisciplina[]
  historico    Historico[]
}

// Uma turma pertence a exatamente uma disciplina.
model Turma {
  id           String        @id
  codigo       String
  periodo      String
  capacidade   Int
  disciplinaId Int
  disciplina   Disciplina     @relation(fields: [disciplinaId], references: [id])
  horarios     HorarioTurma[]
  matriculas   Matricula[]
  listaEspera  ListaEspera[]
  professorId  Int
  docente      Professor        @relation(fields: [professorId], references: [id])

  @@unique([disciplinaId, codigo, periodo])
  @@index([professorId])
}

// Horarios em formato HH:mm; diaSemana: 1=segunda ... 7=domingo.
model HorarioTurma {
  id        Int    @id @default(autoincrement())
  diaSemana Int
  inicio    String
  fim       String
  turmaId   String
  turma     Turma  @relation(fields: [turmaId], references: [id], onDelete: Cascade)
}

// Tabela de ligacao entre aluno e turma, sem matriculas duplicadas.
model Matricula {
  id        Int      @id @default(autoincrement())
  alunoId   Int
  turmaId   String
  criadaEm  DateTime @default(now())
  situacao  String   @default("ATIVA")
  canceladaEm DateTime?
  aluno     Aluno    @relation(fields: [alunoId], references: [id])
  turma     Turma    @relation(fields: [turmaId], references: [id])

  @@unique([alunoId, turmaId])
}

// A ordem de espera sera definida por criadaEm e id.
model ListaEspera {
  id        Int      @id @default(autoincrement())
  alunoId   Int
  turmaId   String
  criadaEm  DateTime @default(now())
  aluno     Aluno    @relation(fields: [alunoId], references: [id])
  turma     Turma    @relation(fields: [turmaId], references: [id])

  @@unique([alunoId, turmaId])
}

// Sessões mantidas no SQLite; apenas o hash do token fica armazenado.
model Sessao {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  alunoId   Int
  expiresAt DateTime
  criadaEm  DateTime @default(now())
  aluno     Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@index([alunoId])
  @@index([expiresAt])
}


// Metas reais por curso, e classificacao contextual por disciplina.
model Curso {
  id            Int                   @id @default(autoincrement())
  codigo        String                @unique
  nome          String                @unique
  chObrigatorias Int
  chPerfil      Int
  chLivre       Int
  curriculos    CurriculoDisciplina[]
  alunos        Aluno[]
}

model CurriculoDisciplina {
  id           Int        @id @default(autoincrement())
  cursoId      Int
  disciplinaId Int
  tipo         String
  curso        Curso      @relation(fields: [cursoId], references: [id])
  disciplina   Disciplina @relation(fields: [disciplinaId], references: [id])

  @@unique([cursoId, disciplinaId])
  @@index([disciplinaId])
}

// Historico anterior ao semestre atual: aprovada ou reprovada.
model Historico {
  id           Int        @id @default(autoincrement())
  alunoId      Int
  disciplinaId Int
  periodo      String
  situacao     String
  aluno        Aluno      @relation(fields: [alunoId], references: [id])
  disciplina   Disciplina @relation(fields: [disciplinaId], references: [id])

  @@unique([alunoId, disciplinaId, periodo])
  @@index([alunoId, situacao])
}


// Professores são cadastrados pela secretaria; e-mail não pode se repetir.
model Professor {
  id     Int     @id @default(autoincrement())
  nome   String
  email  String  @unique
  turmas Turma[]
}


// Conta da secretaria cadastrada pelo seed; acesso e telas serão implementados no módulo administrativo.
model UsuarioSecretaria {
  id        Int    @id @default(autoincrement())
  usuario   String @unique
  email     String @unique
  senhaHash String
}
